{
  "manifest_version": 3,
  "name": "Pets are the best",
  "version": "1.1",
  "description": "A Chrome extension celebrating pets!",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage"],
  "optional_permissions": ["sidePanel"]
}